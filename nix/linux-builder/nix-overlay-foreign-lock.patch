--- a/src/libstore/unix/pathlocks.cc
+++ b/src/libstore/unix/pathlocks.cc
@@ -3,6 +3,7 @@
 #include "nix/util/util.hh"
 #include "nix/util/sync.hh"
 #include "nix/util/signals.hh"
+#include "nix/util/environment-variables.hh"
 
 #include <cerrno>
 #include <cstdlib>
@@ -11,6 +12,7 @@
 #include <sys/types.h>
 #include <sys/stat.h>
 #include <sys/file.h>
+#include <sys/sysmacros.h>
 
 namespace nix {
 
@@ -19,6 +21,17 @@
     AutoCloseFD fd;
 
     fd = open(path.c_str(), O_CLOEXEC | O_RDWR | (create ? O_CREAT : 0), 0600);
+    /* An overlay store whose lower layer is another machine's store shows
+       that machine's locks. Apple's virtiofs refuses even a lookup of one its
+       owner made 0600, so the overlay cannot unlink it. The lock guards the
+       other machine's build, not this one: hide it with a whiteout written
+       straight into the upper layer, and make a fresh one. */
+    if (!fd && create && errno == EACCES && path.parent_path() == "/nix/store")
+        if (auto upper = getEnv("PYNIX_OVERLAY_UPPER_STORE")) {
+            auto whiteout = std::filesystem::path(*upper) / path.filename();
+            if (mknod(whiteout.c_str(), S_IFCHR | 0600, makedev(0, 0)) == 0)
+                fd = open(path.c_str(), O_CLOEXEC | O_RDWR | O_CREAT, 0600);
+        }
     if (!fd && (create || errno != ENOENT))
         throw SysError("opening lock file %1%", PathFmt(path));
 
